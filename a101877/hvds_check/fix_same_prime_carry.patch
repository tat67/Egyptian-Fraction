@@ -128,23 +128,18 @@
 	pp_pp* left = *(pp_pp**)a;
 	pp_pp* right = *(pp_pp**)b;
 
-	if (left->depend) {
-		if (right->depend) {
-			/* dependent PP sort in descending order */
-			return right->pp - left->pp;
-		} else {
-			/* dependent PP sorts after any independent it depends on */
-			return (left->pp * right->pp <= k0) ? +1 : -1;
