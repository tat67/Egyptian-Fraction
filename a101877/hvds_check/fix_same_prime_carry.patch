+}
+
+/* FIX: does a higher power of pp's prime remain in pplist[0 .. i-1]? */
+static int pp_higher_same_prime(int i) {
+	int j;
+	for (j = 0; j < i; ++j)
+		if (pplist[j]->p == pplist[i]->p && pplist[j]->pp > pplist[i]->pp)
+			return 1;
+	return 0;
 }
 
